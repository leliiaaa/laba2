bool isPrime(long long n) {
    if (n <= 1) return false;
    if (n <= 3) return true;
    if (n % 2 == 0 || n % 3 == 0) return false;
    for (long long i = 5; i * i <= n; i += 6) {
        if (n % i == 0 || n % (i + 2) == 0) return false;
    }
    return true;
}

long long getNthPrime(int n) {
    if (n <= 0) return -1;
    int count = 0;
    long long candidate = 1;
    while (count < n) {
        ++candidate;
        if (isPrime(candidate)) {
            ++count;
        }
    }
    return candidate;
}

namespace Task1_2_1 {
    std::queue<int> dataQueue;
    std::mutex mtx;
    bool isInputFinished = false;

    void DataPreparation() {
        std::cout << "[DataPreparation] Vvedit tsili chysla (dlia zavershennia vvedit bukvy abo 'q'):\n";

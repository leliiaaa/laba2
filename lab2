namespace Task1_2_5 {
    void executeWithPolicy(std::launch policy, const std::string& policyName, int n, int choice) {
        std::cout << "\n--- Rezhym: " << policyName << " ---\n";
        auto start = std::chrono::high_resolution_clock::now();

        std::future<long long> primeFuture = std::async(policy, getNthPrime, n);

        std::cout << "Vykonuietsia matematychna diia nad n = " << n << ":\n";
        if (choice == 1) {
            std::cout << "sqrt(" << n << ") = " << std::sqrt(n) << "\n";
        } else if (choice == 2) {
            std::cout << "sin(" << n << ") = " << std::sin(n) << "\n";
        } else {
            std::cout << "ln(" << n << ") = " << (n > 0 ? std::log(n) : 0.0) << "\n";
        }

        std::cout << "Otrymannia rezultatu obchyslennia prostoho chysla...\n";
        long long prime = primeFuture.get();
        auto end = std::chrono::high_resolution_clock::now();

        std::cout << n << "-te proste chyslo: " << prime << "\n";
        std::cout << "Chas vykonannia: "
                  << std::chrono::duration_cast<std::chrono::milliseconds>(end - start).count()
                  << " ms\n";
    }

    void run() {
        int n;
        std::cout << "Vvedit nomer prostoho chysla n: ";
        std::cin >> n;

        std::cout << "Oberit funktsiiu dlia obchyslennia nad " << n << ":\n"
                  << "1 - Korin kvadratnyi (sqrt)\n"
                  << "2 - Synus (sin)\n"
                  << "3 - Naturalnyi loharyfm (ln)\n"
                  << "Vash vybir: ";
        int choice;
        std::cin >> choice;

        executeWithPolicy(std::launch::deferred, "std::launch::deferred", n, choice);
        executeWithPolicy(std::launch::async, "std::launch::async", n, choice);
    }
}

namespace Task1_2_6 {
    std::deque<std::packaged_task<long long()>> taskDeque;
    std::deque<int> nDeque;
    std::mutex dequeMtx;
    std::condition_variable dequeCv;
    bool stopSignal = false;

    void Worker() {
        while (true) {
            std::packaged_task<long long()> task;
            int n = 0;
            {
                std::unique_lock<std::mutex> lock(dequeMtx);
                dequeCv.wait(lock, [] { return !taskDeque.empty() || stopSignal; });

                if (stopSignal && taskDeque.empty()) {
                    break;
                }

                task = std::move(taskDeque.front());
                taskDeque.pop_front();
                n = nDeque.front();
                nDeque.pop_front();
            }

            task();
            std::cout << "[Worker] Rezultat dlia n = " << n << ": " << task.get_future().get() << "\n";
        }
    }

    void run() {
        stopSignal = false;
        std::thread workerThread(Worker);

        std::cout << "Vvodit n dlia obchyslennia prostoho chysla (vvedit 'stop' dlia zavershennia):\n";
        std::string input;
        while (std::cin >> input && input != "stop") {
            try {
                int n = std::stoi(input);
                std::packaged_task<long long()> task([n]() { return getNthPrime(n); });

                {
                    std::lock_guard<std::mutex> lock(dequeMtx);
                    taskDeque.push_back(std::move(task));
                    nDeque.push_back(n);
                }
                dequeCv.notify_one();
            } catch (...) {
                std::cout << "Nekorektnyi vvid. Sprobujte shche raz abo vvedit 'stop'.\n";
            }
        }

        {
            std::lock_guard<std::mutex> lock(dequeMtx);
            stopSignal = true;
        }
        dequeCv.notify_all();

        workerThread.join();
        std::cout << "Usi zavdannia opratsovano. Robotu zaversheno.\n";
    }
}

namespace Task1_2_7 {
    void FirstThread(int n, std::promise<long long> p1, std::promise<bool> pSignal, std::promise<long long> p2) {
        long long nth = getNthPrime(n);
        p1.set_value(nth);

        pSignal.set_value(true);

        long long nTimes10th = getNthPrime(n * 10);
        p2.set_value(nTimes10th);
    }

    void SecondThread(int n, std::future<bool> futSignal) {
        if (futSignal.get()) {
            std::this_thread::sleep_for(std::chrono::seconds(2));
            std::cout << "\n[Potik 2] Kvadratnyi korin vid " << n << " = " << std::sqrt(n) << "\n";
        }
    }

    void run() {
        int n;
        std::cout << "Vvedit nomer prostoho chysla n: ";
        std::cin >> n;

        std::promise<long long> p1;
        std::promise<bool> pSignal;
        std::promise<long long> p2;

        std::future<long long> f1 = p1.get_future();
        std::future<bool> fSignal = pSignal.get_future();
        std::future<long long> f2 = p2.get_future();

        std::thread t2(SecondThread, n, std::move(fSignal));
        std::thread t1(FirstThread, n, std::move(p1), std::move(pSignal), std::move(p2));

        std::cout << "[Holovnyi potik] " << n << "-te proste chyslo: " << f1.get() << "\n";
        std::cout << "[Holovnyi potik] (" << n << "*10)-te proste chyslo: " << f2.get() << "\n";

        t1.join();
        t2.join();
    }
}



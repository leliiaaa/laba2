namespace Task1_2_2 {
    std::mutex mtx;
    std::condition_variable cv;
    int i = 0;

    void Waits(int id) {
        std::unique_lock<std::mutex> lock(mtx);
        std::cout << "[Potik " << id << "] Vkhodyt u stan ochikuvannia.\n";
        cv.wait(lock, [] { return i == 1; });
        std::cout << "[Potik " << id << "] Ochikuvannia zavershene (i = " << i << ").\n";
    }

    void Awake() {
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
        std::cout << "[Awake] Pershe spovishchennia (i = " << i << ") cherez notify_all()...\n";
        cv.notify_all();

        std::this_thread::sleep_for(std::chrono::milliseconds(100));
        {
            std::lock_guard<std::mutex> lock(mtx);
            i = 1;
        }
        std::cout << "[Awake] Zminnu i vstanovleno v 1. Povtorne spovishchennia cherez notify_all()...\n";
        cv.notify_all();
    }

    void run() {
        i = 0;
        std::thread w1(Waits, 1);
        std::thread w2(Waits, 2);
        std::thread w3(Waits, 3);
        std::thread a(Awake);

        a.join();
        w1.join();
        w2.join();
        w3.join();
    }
}

namespace Task1_2_3 {
